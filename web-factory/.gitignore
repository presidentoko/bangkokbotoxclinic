node_modules/
.next/
out/
.env*.local
.vercel

# Generated by scripts/build_compare_index.mts / build_browse_index.mts (pre{dev,build} hook) from master_db
public/compare-index.json
public/browse-index.json
public/city-index.json
*.tsbuildinfo
next-env.d.ts

# Runtime state — per-machine
.last_auto_rebuild
.claude/

# Cloudflare Wrangler local cache
.wrangler/

# DBD JS 번들 — re-downloadable via scripts/dbd_fetch_js.py
scripts/dbd_bundles/

# 마이그레이션 백업 — 작업 끝나면 삭제
data/master_db.legacy.json
data/master_db.json.bak-*

# Raw Apify export dumps (~100MB+) — merged into master_db.json by
# scripts/apify_to_master_db.py, kept locally as an archive/re-merge source,
# not meant for git. Drop new Apify downloads straight into this folder.
data/apify_raw/

# Google Maps 백업 사진 — 55MB, deploy 시점에 build 가 out/ 으로 복사.
# git 에 넣을지는 추후 결정 (Cloudflare R2 등 별도 storage 권장).
public/photos/

# export/ — verified_final + premium_final + INTEGRATION.md 만 commit, 나머지는 너무 큼
export/*
!export/thaisupplyhub_verified_final.csv
!export/thaisupplyhub_premium_final.csv
!export/INTEGRATION.md
data/photo_url_cache.json

# 링크 검사 원본 판정 (800KB, 매 검사마다 재생성). 결론인
# data/website_corrections.json 만 커밋한다 — 그게 리빌드가 실제로 읽는 파일.
data/website_check.json
data/website_recheck.json
