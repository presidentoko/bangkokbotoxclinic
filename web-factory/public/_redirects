# Cloudflare Pages redirects.
# Cycle 2: /course/[id] → /supplier/[id] (URL semantic upgrade).
# 301 (permanent) so any indexed legacy URL preserves SEO equity.
/course/* /supplier/:splat 301

# District-canonical (/d/*, /c/:cat/*) and legacy city-slug (/city/*, /ko/city/*)
# aliases used to live here as ~190 individual lines, but Cloudflare Pages only
# honors the FIRST 100 rules in this file — everything past that point (which
# included every /city/* alias) was silently 404ing in production. Moved to
# functions/_lib/aliases.ts + scoped middleware (functions/d, functions/c,
# functions/city, functions/ko/city), which has no rule-count ceiling.

# Removed supplier IDs are handled by functions/supplier/_middleware.ts,
# which returns a real 410 Gone instead of a soft-404-flavored redirect.
# (No _redirects line here — this file can't emit a 410 status.)
