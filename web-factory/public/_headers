# Cloudflare Pages headers — static export.
# All HTML revalidates often (data changes); fingerprinted assets cache forever.
#
# Rule matching: every matching block contributes its headers, and a more
# specific path wins for a header it redefines. So the `/*` block below sets the
# baseline for the whole site and the narrower blocks override Cache-Control
# only for their own paths.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400

# The Cache-Control above used to live under `/` plus `/*.html`, which covered
# almost nothing: trailingSlash is off, so real page URLs are extensionless
# (/c/manufacturer, /supplier/{id}) and never matched `/*.html`. Every page
# except the homepage was served with Cloudflare Pages' default
# `max-age=0, must-revalidate` — a full revalidation on every hit, on a site
# that is a pure static export. Verified in production before changing it.

# Client-side data indexes — regenerated with each data refresh, same cadence
# as the HTML that links them. browse-index.json is ~1.9MB, so a repeat visit
# reusing it instead of refetching is the single biggest win here.
/browse-index.json
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400
/compare-index.json
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400
/city-index.json
  Cache-Control: public, max-age=300, s-maxage=300, stale-while-revalidate=86400

# Course photos — scraped, rarely change
/course-photos/*
  Cache-Control: public, max-age=2592000, immutable

# Next.js fingerprinted assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# llms.txt / feed.xml — refresh hourly
/llms.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
/llms-full.txt
  Cache-Control: public, max-age=3600, s-maxage=3600
/feed.xml
  Cache-Control: public, max-age=1800, s-maxage=1800
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=3600
