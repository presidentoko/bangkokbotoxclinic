# RFQ + Lead-magnet 폼 백엔드 (Formspree / Web3Forms / Cloudflare Pages Functions).
# 비워두면 mailto: 폴백 (브라우저가 메일앱 열음).
NEXT_PUBLIC_RFQ_ENDPOINT=
NEXT_PUBLIC_LEAD_MAGNET_ENDPOINT=
NEXT_PUBLIC_LEAD_MAGNET_PDF_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# 유료 PDF Gumroad / Lemon Squeezy URL. 비워두면 PaidPdfCta hidden.
NEXT_PUBLIC_PAID_PDF_URL=

# 사이트 base URL — Vercel domain 또는 custom. 슬래시 없이.
NEXT_PUBLIC_SITE_URL=https://thailandgolfguide.com

# 표기 brand 이름 (헤더/메타에 노출).
NEXT_PUBLIC_BRAND=Thailand Golf Guide

# Klook 어필리에이트 ID. 비워두면 일반 검색링크.
NEXT_PUBLIC_KLOOK_AID=

# AdSense client ID (ca-pub-...). 비워두면 광고 슬롯 hidden.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 외부 사진 CDN base URL (예: Cloudflare R2 + 도메인 binding).
# 비워두면 local public/photos/ 사용 (small site OK).
# 설정 시 "/photos/{place_id}/{n}.jpg" path 가 "{BASE}/photos/{place_id}/{n}.jpg" 로 변환.
# 예: https://photos.thaisupplyhub.com
NEXT_PUBLIC_PHOTOS_BASE=
