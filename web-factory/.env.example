# RFQ + Lead-magnet 폼 백엔드 (Formspree / Web3Forms / Cloudflare Pages Functions).
# 비워두면 mailto: 폴백 (브라우저가 메일앱 열음).
NEXT_PUBLIC_RFQ_ENDPOINT=
NEXT_PUBLIC_LEAD_MAGNET_ENDPOINT=
NEXT_PUBLIC_LEAD_MAGNET_PDF_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# 유료 PDF Gumroad / Lemon Squeezy URL. 비워두면 PaidPdfCta hidden.
NEXT_PUBLIC_PAID_PDF_URL=

# 사이트 base URL — Vercel domain 또는 custom. 슬래시 없이.
NEXT_PUBLIC_SITE_URL=https://thailandgolfguide.com

# 표기 brand 이름 (헤더/메타에 노출).
NEXT_PUBLIC_BRAND=Thailand Golf Guide

# Klook 어필리에이트 ID. 비워두면 일반 검색링크.
NEXT_PUBLIC_KLOOK_AID=

# AdSense client ID (ca-pub-...). 비워두면 광고 슬롯 hidden.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 외부 사진 CDN base URL (예: Cloudflare R2 + 도메인 binding).
# 비워두면 local public/photos/ 사용 (small site OK).
# 설정 시 "/photos/{place_id}/{n}.jpg" path 가 "{BASE}/photos/{place_id}/{n}.jpg" 로 변환.
# 예: https://photos.thaisupplyhub.com
NEXT_PUBLIC_PHOTOS_BASE=

# ── 광고 판매 ───────────────────────────────────────────────────────────────
# Sponsored 슬롯 / Verified 배지에 들어갈 supplier ID (콤마 구분).
# ⚠️ 반드시 NEXT_PUBLIC_ 로 넣을 것 — SupplierCard/Badges 가 client component 라
#    접두사 없는 값은 브라우저에서 undefined 가 되어 배지가 하이드레이션 때 사라진다.
NEXT_PUBLIC_SPONSORED_EDITORS_PICK=
NEXT_PUBLIC_SPONSORED_RECOMMENDED=
NEXT_PUBLIC_SPONSORED_FEATURED=
NEXT_PUBLIC_VERIFIED_SUPPLIERS=
NEXT_PUBLIC_VERIFIED_PREMIUM_SUPPLIERS=
NEXT_PUBLIC_VERIFIED_ENTERPRISE_SUPPLIERS=

# 결제 링크 (Stripe Payment Link / PromptPay 안내 페이지 등).
# 비워두면 /for-suppliers 는 이메일 문의 CTA 만 보여준다.
NEXT_PUBLIC_PAY_VERIFIED=
NEXT_PUBLIC_PAY_VERIFIED_PREMIUM=
NEXT_PUBLIC_PAY_VERIFIED_ENTERPRISE=

# Cloudflare Web Analytics 토큰 (대시보드 → Web Analytics → 사이트 추가).
# 비워두면 분석 스크립트가 아예 렌더되지 않는다.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# LINE 공식계정 URL (선택) — /for-suppliers 문의 버튼.
NEXT_PUBLIC_LINE_OA_URL=

# ── Cloudflare Pages Functions (서버 전용, NEXT_PUBLIC_ 금지) ──────────────
# 문의 폼 → 텔레그램. 절대 코드에 하드코딩하지 말 것 (탈취 이력 있음).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
