{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- thaifacialclinic-portable/ && exit 0; exit 1",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
