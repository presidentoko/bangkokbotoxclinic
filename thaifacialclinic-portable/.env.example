# ── Required (without these, dashboard/leads do not work) ────────────────
# Site canonical URL (used in metadata, mailto links, OG tags)
NEXT_PUBLIC_SITE_URL=https://thaifacialclinic.com

# Staff master password — issue per-clinic tokens, view all dashboards
# Generate a long random string. Stored in HttpOnly cookie (base64-encoded).
ADMIN_PASSCODE=

# Upstash Redis REST (https://console.upstash.com)
# Free tier 10k cmds/day is plenty for low-mid traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Optional (graceful degradation if not set) ───────────────────────────
# Anthropic Claude API — for AI-drafted review replies.
# Without this, replies use built-in templates (still works, just not AI).
ANTHROPIC_API_KEY=
ANTHROPIC_REPLY_MODEL=claude-haiku-4-5

# Slack/Discord webhook — new leads posted as messages.
# Discord setup: server → channel → ⚙ → Integrations → Webhooks → New webhook → Copy URL.
LEAD_WEBHOOK_URL=

# Telegram bot (FREE forever) — instant phone push for every new lead.
# Setup: (1) In Telegram open @BotFather → /newbot → save the bot token below.
#        (2) Start a chat with your new bot, then open @userinfobot → shows your chat id.
# Both env vars required. Missing either → Telegram step silently skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fallback email (logged for manual relay when no partner contact_email).
FALLBACK_LEAD_EMAIL=

# Local CSV path for data regeneration. If unset, falls back to ./data/master.csv
HAIR_MASTER_CSV=


# ── Sponsored slots (paid Featured) — CSV of clinic IDs ──────────────────
# Higher tier = top of directory. Edit + redeploy to update.
SPONSORED_EDITORS_PICK=
SPONSORED_RECOMMENDED=
SPONSORED_FEATURED=


# ── PromptPay QR (Thai bank transfer) — receive partner payments ─────────
# Your Thai phone number (0XX-XXX-XXXX) or 13-digit national ID.
# Shown in QR codes for partner payments. Anyone scans → transfers to your bank.
NEXT_PUBLIC_PROMPTPAY_ID=0812345678


# ── Email (Resend.com) — weekly digest cron + payment confirmations ─────
# Get free key at https://resend.com (100/day, 3000/mo free).
RESEND_API_KEY=
EMAIL_FROM=BKK Clinics <noreply@bkkclinics.com>

# Cron secret — Vercel auto-sets in production. For local test:
# curl http://localhost:3000/api/cron/weekly-digest -H "authorization: Bearer $CRON_SECRET"
CRON_SECRET=
