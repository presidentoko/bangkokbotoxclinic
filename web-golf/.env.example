# 사이트 base URL — Vercel domain 또는 custom. 슬래시 없이.
NEXT_PUBLIC_SITE_URL=https://www.thailandgolfguide.com

# 표기 brand 이름 (헤더/메타에 노출).
NEXT_PUBLIC_BRAND=Thailand Golf Guide

# ── Affiliate IDs (Tier 1: simple AID, partner native query param) ──
# 가입 절차는 AFFILIATE_SETUP.md 참고. 빈 값이면 일반 검색링크 (트래킹 없음).

# Klook Affiliate Program → 'aid' query param OR full redirect template (둘 중 하나)
NEXT_PUBLIC_KLOOK_AID=

# Booking.com Partner Program → 'aid' query param (직접 지원)
NEXT_PUBLIC_BOOKING_AID=

# Agoda Partner Program → 'cid' query param (직접 지원)
NEXT_PUBLIC_AGODA_AID=

# Trip.com Partner Center → Allianceid + SID + 옵션 trip_sub3 deeplink code.
# 예: https://www.trip.com/?Allianceid=8250663&SID=313031699&trip_sub3=D17154748
#   → AID=8250663  SID=313031699  SUB3=D17154748
NEXT_PUBLIC_TRIPCOM_AID=
NEXT_PUBLIC_TRIPCOM_SID=
NEXT_PUBLIC_TRIPCOM_SUB3=

# Golfsavers / Sawasdee Golf — 보통 직접 affiliate API 없음. URL template 권장.
NEXT_PUBLIC_GOLFSAVERS_AID=
NEXT_PUBLIC_SAWASDEE_AID=

# Expedia / Skyscanner / Rentalcars — 모두 affiliate network redirect 필요.
# 위 AID는 일부 partner에서만 동작 — URL_TEMPLATE 쪽이 정석.
NEXT_PUBLIC_EXPEDIA_AID=
NEXT_PUBLIC_SKYSCANNER_AID=
NEXT_PUBLIC_RENTALCARS_AID=

# ── Affiliate URL templates (Tier 2: CJ / Awin / Impact / Partnerize) ──
# 각 affiliate 네트워크 대시보드에서 받은 deep-link 템플릿. {q} {city} {origin} {dest} {target}
# 같은 placeholder 자동 치환됨. 예시:
#   NEXT_PUBLIC_BOOKING_URL_TEMPLATE=https://www.awin1.com/cread.php?awinmid=12345&awinaffid=YOUR_AFFID&p={target}
#   NEXT_PUBLIC_KLOOK_URL_TEMPLATE=https://affiliate.klook.com/redirect?aid=YOUR_AID&deeplink={target}
# Tier 2 가 설정되면 Tier 1 AID 무시하고 redirect URL 사용. 트래킹 정확도 ↑.
NEXT_PUBLIC_KLOOK_URL_TEMPLATE=
NEXT_PUBLIC_BOOKING_URL_TEMPLATE=
NEXT_PUBLIC_AGODA_URL_TEMPLATE=
NEXT_PUBLIC_EXPEDIA_URL_TEMPLATE=
NEXT_PUBLIC_TRIPCOM_URL_TEMPLATE=
NEXT_PUBLIC_SKYSCANNER_URL_TEMPLATE=
NEXT_PUBLIC_RENTALCARS_URL_TEMPLATE=
NEXT_PUBLIC_GOLFSAVERS_URL_TEMPLATE=
NEXT_PUBLIC_SAWASDEE_URL_TEMPLATE=

# AdSense client ID (ca-pub-...). 비워두면 광고 슬롯 hidden.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ── Search Console verification (소유 인증용 meta 태그 자동 삽입) ──
# Google Search Console → 속성 추가 → 'HTML 태그' 메서드 → content 값만.
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools → 사이트 추가 → 'Meta tag' → content 값.
NEXT_PUBLIC_BING_VERIFICATION=
# Naver Webmaster Tools (https://searchadvisor.naver.com) → 사이트 등록 → 'HTML 태그' → content 값.
NEXT_PUBLIC_NAVER_VERIFICATION=
# Yandex Webmaster (러시아 봇용, 선택). content 값만.
NEXT_PUBLIC_YANDEX_VERIFICATION=
