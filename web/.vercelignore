# Explicit ignore — needed for --archive=tgz mode (auto-exclusion bypassed)
# 주의: .git 은 절대 넣지 말 것 — git 배포에서 빌드 컨테이너의 .git(얕은
# 클론이라 작음)까지 지워져 ignoreCommand 의 git diff 가 "Not a git
# repository"로 죽고 배포 전체가 ERROR 남 (2026-07-11 사고).
node_modules
.next
.vercel
.env
.env.local
.env.development
.env.production
.env*.local
*.tsbuildinfo
next-env.d.ts

# Backup files (combined 28-45MB)
data/master_db.json.bak-*
data/*.bak
data/*.bak-*

# Big per-clinic data dirs (moved out — see /tmp/web-data-backup)
data/photos/
data/pricing/
data/wiki_summaries/
data/external_reviews/
data/doctor_xref/

# Scraper / dev scripts not needed at runtime
data/.crisis_state.json
outreach_targets.csv
outreach_*.csv

# Python build scripts
scripts/__pycache__/
scripts/*.py
scripts/*.pyc

# README / dev docs
README.md
*.md
