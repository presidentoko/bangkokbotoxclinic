# ── 코어 (production 필수) ────────────────────────────────────
# 사이트 base URL — Vercel domain 또는 커스텀 도메인. 슬래시 없이.
NEXT_PUBLIC_SITE_URL=https://bangkokbotoxclinic.com

# 사이트 포커스 — 같은 코드베이스 multi-domain 분기.
# 값: all | botox | filler | hifu | facial | laser | dental
# 미설정 시 "all" (전체 클리닉 메인 허브).
NEXT_PUBLIC_SITE_FOCUS=botox

# 헤더/footer 노출용 contact 이메일.
NEXT_PUBLIC_CONTACT_EMAIL=umma@xx.gg


# ── 수익화 — 옵션 (없으면 그 슬롯 hidden 또는 fallback) ─────────
# Klook 어필리에이트 ID. https://affiliate.klook.com 가입 후 받음.
# 비워두면 affiliate 링크가 일반 검색 URL로 fallback.
NEXT_PUBLIC_KLOOK_AID=

# AdSense client ID (ca-pub-...). https://www.google.com/adsense 승인 후 받음.
# 비워두면 광고 슬롯 안 렌더.
NEXT_PUBLIC_ADSENSE_CLIENT=

# 새 lead (BookingForm 제출) 통지 받을 webhook.
# Slack: Incoming Webhooks 만들고 URL 복사 (https://hooks.slack.com/services/...)
# Discord: 채널 → Edit → Integrations → Webhooks → New Webhook
# 비워두면 lead는 server log만 남음.
LEAD_WEBHOOK_URL=


# ── Sponsored 슬롯 (유료 featured) ─────────────────────────────
# 클리닉 ID CSV. 유료 광고주가 결제하면 ID를 여기 추가 → 사이트 상단 우선 노출.
# ID는 사이트 URL의 `/clinic/<ID>` 에서 확인.
# Editor's Pick (최상위 보라색 배지, ฿15,000/월 권장)
SPONSORED_EDITORS_PICK=
# Recommended (파란색 배지, ฿10,000/월 권장)
SPONSORED_RECOMMENDED=
# Featured (회색 배지, ฿5,000/월 권장)
SPONSORED_FEATURED=


# ── SEO / 검증 (Search Console / Bing Webmaster 가입 시) ────
# Google Search Console: https://search.google.com/search-console
# 도메인 verify 시 meta tag 방식 → content 부분만 복사
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster: https://www.bing.com/webmasters
NEXT_PUBLIC_BING_VERIFICATION=
