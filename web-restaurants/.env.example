# ── 코어 (production 필수) ────────────────────────────────────
# 사이트 base URL.
NEXT_PUBLIC_SITE_URL=https://snsstopper.com

# 표기 brand 이름 (헤더/메타에 노출). 도메인별 분기 시 변경.
NEXT_PUBLIC_BRAND=SNS Stopper

# 헤더/footer 노출용 contact 이메일.
NEXT_PUBLIC_CONTACT_EMAIL=umma@xx.gg


# ── 수익화 — 옵션 ──────────────────────────────────────────────
# Klook 어필리에이트 ID. https://affiliate.klook.com 가입 후 받음.
NEXT_PUBLIC_KLOOK_AID=

# AdSense client ID (ca-pub-...). https://www.google.com/adsense
NEXT_PUBLIC_ADSENSE_CLIENT=


# ── Sponsored 슬롯 (유료 featured) ─────────────────────────────
# 식당 ID CSV. /restaurant/<ID> 에서 확인.
# Editor's Pick (오렌지 배지, ฿8,000/월 권장)
SPONSORED_EDITORS_PICK=
# Recommended (소프트 배지, ฿5,000/월 권장)
SPONSORED_RECOMMENDED=
# Featured (회색 배지, ฿3,000/월 권장)
SPONSORED_FEATURED=


# ── SEO 검증 ───────────────────────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=


# ── Upstash Redis (커뮤니티 투표/신고) ─────────────────────────
# https://console.upstash.com → 새 Redis DB → REST API 탭에서 복사
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
