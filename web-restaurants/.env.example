# 사이트 베이스 URL — Vercel domain 또는 커스텀 도메인. 슬래시 없이.
NEXT_PUBLIC_SITE_URL=https://bangkokbotoxclinic.com

# 사이트 포커스 — 도메인별 분기. 같은 코드베이스 multi-deploy.
# 값: all | botox | filler | hifu | facial | laser | dental
# 미설정 시 "all" (전체 클리닉 메인 허브).
NEXT_PUBLIC_SITE_FOCUS=botox

# Klook 어필리에이트 ID (광고주 ID). 비워두면 일반 검색링크.
NEXT_PUBLIC_KLOOK_AID=

# AdSense client ID (ca-pub-...). 비워두면 광고 슬롯 안 띄움.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Lead 들어오면 통지 받을 webhook URL (Slack incoming webhook 등).
# 비워두면 stdout 으로만 로깅 됨.
LEAD_WEBHOOK_URL=
